    copts = ["-std=c++20", "-O2"],

    visibility = ["//runtime:clients"],
)

cc_library(
    name = "pretty_printer",
    srcs = [
        "pretty_printer.cc",
        "pretty_printer.h",
    ],
    visibility = ["//runtime:clients"],
)

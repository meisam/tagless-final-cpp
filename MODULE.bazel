"""
A demo of tagless-final style in multiple languages
"""

module(
    name = "tagless_final_cpp",
    version = "0.0.1",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(
    name = "protobuf",
    version = "34.1",
)

bazel_dep(
    name = "llvm",
    version = "0.8.3",
)

register_toolchains("@llvm//toolchain:all")

bazel_dep(
  name = "rules_cc",
  version = "0.2.18",
)

bazel_dep(
  name = "rules_go",
  version = "0.60.0",
)

bazel_dep(
  name = "googletest",
  version = "1.17.0.bcr.2",
)
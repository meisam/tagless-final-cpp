"""
A demo of tagless-final style in multiple languages
"""

module(
    name = "tagless_final_cpp",
    version = "0.0.1",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(
    name = "protobuf",
    version = "34.1",
)
bazel_dep(
    name = "llvm",
    version = "0.8.3",
)

register_toolchains("@llvm//toolchain:all")

bazel_dep(
    name = "rules_cc",
    version = "0.2.18",
)
bazel_dep(
    name = "rules_go",
    version = "0.60.0",
)
bazel_dep(
    name = "googletest",
    version = "1.17.0.bcr.2",
)
bazel_dep(name = "toolchains_llvm", version = "1.7.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "wolfd_bazel_compile_commands", version = "0.5.2")

llvm_formatter = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm_formatter.toolchain(
    name = "llvm_formatter_toolchain",
    llvm_version = "19.1.0",
)
use_repo(llvm_formatter, "llvm_formatter_toolchain")
